# Source distribution: the package plus everything a checkout has.
include LICENSE README.md README_DE.md QUICKSTART.md QUICKSTART_DE.md SANDBOX.md TODO.md RELEASING.md PROXMOX_LXC.md PROXMOX_LXC_DE.md INTEGRATIONS.md INTEGRATIONS_DE.md
include install.sh sandbox-ai
recursive-include sandbox Containerfile.* build_image.sh release-signers mcp-signers public_suffix_list.dat
graft sandbox/web
graft sandbox/presets
graft sandbox/templates
graft sandbox/builtin
graft sandbox/marketplace
recursive-include tests *.py
recursive-include docs *.py *.md
recursive-include tests/golden *
recursive-include scripts *.py *.sh
recursive-include packaging *
global-exclude __pycache__ *.py[cod]
