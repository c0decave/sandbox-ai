# Source distribution: the package plus everything a checkout has.
include LICENSE THIRD-PARTY.md README.md README_DE.md QUICKSTART.md QUICKSTART_DE.md SANDBOX.md TODO.md RELEASING.md PROXMOX_LXC.md PROXMOX_LXC_DE.md INTEGRATIONS.md INTEGRATIONS_DE.md
include install.sh sandbox-ai
recursive-include sandbox Containerfile.* build_image.sh release-signers mcp-signers public_suffix_list.dat
graft sandbox/web
graft sandbox/launcher
graft sandbox/presets
graft sandbox/recipes
graft sandbox/service-images
graft sandbox/templates
graft sandbox/builtin
graft sandbox/marketplace
recursive-include tests *.py *.sh
recursive-include docs *.py *.md
# Internal notes (scripts/make_dist.py INTERNAL): never in a release file.
exclude docs/AGENT_HOSTS.md docs/MCP_SIGNING_AXROSS.md
recursive-include tests/golden *
recursive-include scripts *.py *.sh
recursive-include packaging *
global-exclude __pycache__ *.py[cod]
