#!/usr/bin/env bash
set -euo pipefail
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
podman_cmd=(podman)
if [[ "${1:-}" == --podman-url ]]; then
  [[ $# -ge 2 ]] || { echo '--podman-url needs a URL' >&2; exit 2; }
  podman_cmd+=(--remote --url "$2")
  shift 2
fi
exec "${podman_cmd[@]}" build --tag localhost/agent-sandbox:latest --file "$script_dir/sandbox/Containerfile" "$@" "$script_dir/sandbox"
