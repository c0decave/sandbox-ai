#!/usr/bin/env bash
set -euo pipefail
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
# Deprecated since 0.1.30, to be removed in a later version: the same as `sandbox-ai list|attach|pause|resume|stop|delete`.
[[ ${SANDBOX_AI_NO_DEPRECATION:-} == 1 ]] || echo "sandbox-session: deprecated, to be removed in a later version; use: sandbox-ai list|attach|pause|resume|stop|delete (SANDBOX_AI_NO_DEPRECATION=1 hides this note)" >&2
exec python3 -I "$script_dir/sandbox/sessions.py" "$@"
