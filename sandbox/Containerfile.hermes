# Hermes Agent (NousResearch/hermes-agent, MIT) as sandbox-ai's agent hermes (sandbox-ai build hermes).
# Only the reviewed release (docs/HERMES_REVIEW.md, sandbox/hermes.py): its source from Git at the tag, checked
# against the reviewed commit; its Python dependencies hash-pinned (Containerfile.hermes.lock, from upstream's uv.lock
# by scripts/hermes_lock.py); CPython from uv's own builds (their checksums are part of uv). Nothing is piped into a
# shell, and Hermes cannot update itself: its install is read-only in the sandbox (a new release is reviewed, then
# built here).
# uv ships as a static binary in its official image; COPY --from takes only it. Pinned: it also decides the CPython
# build (the newest uv release at least 14 days old when Hermes was taken in).
ARG UV_VERSION=0.13.5
# Floating tag: the current Active LTS line with its newest patch release (the agents' common base: Node.js runs MCP
# servers and the browser tools' helpers).
# Pin with --build-arg NODE_IMAGE=docker.io/library/node:<version>-bookworm-slim.
ARG NODE_IMAGE=docker.io/library/node:lts-bookworm-slim
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${NODE_IMAGE}

# The reviewed release; another one fails the commit check below (and its dependencies would not match the lock).
ARG HERMES_VERSION=0.22.5
ARG HERMES_COMMIT=bf0203a794a07aac3ff764972ab9087baa4e4f4e
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash git python3 python3-pip python3-venv firejail nftables ripgrep util-linux \
    vim netcat-traditional bind9-dnsutils iputils-ping iproute2 traceroute curl wget tmux \
    openssh-client jq openssl \
    && rm -rf /var/lib/apt/lists/*
# GitHub CLI from GitHub's own apt repository (Debian's gh is years behind), the key over HTTPS.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg \
       https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
RUN gh --version
# GUI base (--gui): virtual display, VNC over a Unix socket, fonts and the runtime libraries Playwright's Chromium
# needs (Hermes' browser tools drive a local Chromium; fetched at run time, e.g. `uvx playwright install chromium`).
# libxcb-icccm4 and libxcb-keysyms1: Qt's xcb platform (a Qt program with --gui) loads them beside libxcb-cursor0;
# libpulse0: Qt Multimedia loads it (sound itself: the image variant media).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc x11-utils fonts-liberation fonts-dejavu-core \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcairo-gobject2 libcups2 \
    libdbus-1-3 libdbus-glib-1-2 libdrm2 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcb-shm0 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libxtst6 \
    libegl1 libgl1 libopengl0 libxkbcommon-x11-0 libxcb-cursor0 libxshmfence1 libxkbfile1 libfontconfig1 gdb \
    libxcb-icccm4 libxcb-keysyms1 libpulse0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN python3 -m pip --version && uv --version
# Hermes' source at the reviewed tag, checked against the reviewed commit; what it does not need at run time (its
# tests, website, desktop apps) is left out. No .git: Hermes' own updater has nothing to pull.
RUN git clone --quiet --depth 1 --branch "v${HERMES_VERSION}" https://github.com/NousResearch/hermes-agent.git \
       /opt/hermes/src \
    && test "$(git -C /opt/hermes/src rev-parse HEAD)" = "${HERMES_COMMIT}" \
    && rm -rf /opt/hermes/src/.git /opt/hermes/src/tests /opt/hermes/src/tests-js /opt/hermes/src/website \
       /opt/hermes/src/apps /opt/hermes/src/evals /opt/hermes/src/contributors
COPY Containerfile.hermes.lock /opt/hermes/requirements.lock
# CPython 3.14 (Hermes' own) beside Debian's python3, which sandbox-ai's setup keeps using; the dependencies exactly
# as locked, then Hermes from its source tree on the venv's path, and the hermes command.
ENV UV_PYTHON_INSTALL_DIR=/opt/hermes/python UV_NO_CONFIG=1 UV_CACHE_DIR=/tmp/uv-cache
RUN uv python install --no-bin 3.14 \
    && uv venv --python 3.14 --python-preference only-managed /opt/hermes/venv \
    && uv pip install --python /opt/hermes/venv/bin/python --require-hashes --no-deps \
       -r /opt/hermes/requirements.lock \
    && /opt/hermes/venv/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])' \
       | xargs -I{} sh -c 'echo /opt/hermes/src > "{}/hermes-agent.pth"' \
    && printf '#!/bin/sh\nexec /opt/hermes/venv/bin/python -m hermes_cli.main "$@"\n' > /usr/local/bin/hermes \
    && chmod 755 /usr/local/bin/hermes \
    && rm -rf /tmp/uv-cache
# Its managed configuration is mounted here by the launcher (read-only, sandbox/hermes.py); the bundled skills stay
# with the source.
ENV HERMES_BUNDLED_SKILLS=/opt/hermes/src/skills HERMES_OPTIONAL_SKILLS=/opt/hermes/src/optional-skills \
    HERMES_OPTIONAL_MCPS=/opt/hermes/src/optional-mcps
RUN mkdir -p -m 755 /etc/hermes && HERMES_HOME=/tmp/hermes-check hermes --version && rm -rf /tmp/hermes-check
ENV HOME=/root
WORKDIR /work
