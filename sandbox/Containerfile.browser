# The browser container of sandbox-ai (`sandbox-ai build browser`): the sandbox's own browser (--browser), beside
# the agent in its pod, on the agent's network. Debian's own packages of the base image's release - Chromium,
# Firefox ESR, Xvfb, x11vnc, NSS's certutil (the run's CA into Chromium's trust store) - and python3 for the
# runtime (sandbox/browser_runtime.py and runtime.py, mounted read-only at /sandbox-browser at every start, so a new
# sandbox-ai version needs no rebuild). No agent and no other tools. `sandbox-ai build browser` pins the base by
# its digest (DEBIAN_IMAGE=docker.io/library/debian@sha256:...) and labels the image with it.
ARG DEBIAN_IMAGE=docker.io/library/debian:bookworm-slim

FROM ${DEBIAN_IMAGE}
ARG DEBIAN_IMAGE
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates util-linux xvfb x11vnc chromium firefox-esr libnss3-tools \
    fonts-dejavu-core fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
# Policies: nothing of the browsers' own on the network (updates, studies, metrics, sync: a Tor run would be
# linkable by them, and every one would be an approval question), no password manager (the agent may drive it),
# and for Firefox the run's CA (Chromium's goes into its NSS database at the start).
RUN mkdir -p /etc/chromium/policies/managed /usr/lib/firefox-esr/distribution /etc/firefox/policies \
    && printf '%s\n' '{"MetricsReportingEnabled": false, "SyncDisabled": true, "BrowserSignin": 0,' \
       '"PasswordManagerEnabled": false, "SafeBrowsingProtectionLevel": 0, "ComponentUpdatesEnabled": false,' \
       '"BackgroundModeEnabled": false, "DefaultBrowserSettingEnabled": false, "PromotionalTabsEnabled": false,' \
       '"SpellCheckServiceEnabled": false, "SearchSuggestEnabled": false, "NetworkPredictionOptions": 2,' \
       '"TranslateEnabled": false, "UrlKeyedAnonymizedDataCollectionEnabled": false,' \
       '"DnsOverHttpsMode": "off", "QuicAllowed": false}' \
       > /etc/chromium/policies/managed/sandbox-ai.json \
    && printf '%s\n' '{"policies": {"Certificates": {"Install": ["/sandbox-browser/ca.pem"]},' \
       '"DisableAppUpdate": true, "DisableTelemetry": true, "DisableFirefoxStudies": true,' \
       '"DisableFirefoxAccounts": true, "DisablePocket": true, "DontCheckDefaultBrowser": true,' \
       '"OfferToSaveLogins": false, "PasswordManagerEnabled": false, "CaptivePortal": false,' \
       '"NetworkPrediction": false, "SearchSuggestEnabled": false, "ExtensionUpdate": false,' \
       '"OverrideFirstRunPage": "", "OverridePostUpdatePage": "",' \
       '"DNSOverHTTPS": {"Enabled": false, "Locked": true},' \
       '"Preferences": {"browser.safebrowsing.malware.enabled": {"Value": false, "Status": "locked"},' \
       '"browser.safebrowsing.phishing.enabled": {"Value": false, "Status": "locked"},' \
       '"network.connectivity-service.enabled": {"Value": false, "Status": "locked"}}}}' \
       > /usr/lib/firefox-esr/distribution/policies.json \
    && cp /usr/lib/firefox-esr/distribution/policies.json /etc/firefox/policies/policies.json \
    && python3 -c 'import json; [json.load(open(p)) for p in ("/etc/chromium/policies/managed/sandbox-ai.json", "/usr/lib/firefox-esr/distribution/policies.json")]'
RUN chromium --version && firefox-esr --version && x11vnc -version && command -v Xvfb && command -v certutil \
    && command -v setpriv && python3 --version
RUN mkdir -p /sandbox-browser
LABEL sandbox-ai.role=browser
LABEL sandbox-ai.base=${DEBIAN_IMAGE}
ENTRYPOINT ["/usr/bin/python3", "-I", "/sandbox-browser/browser_runtime.py"]
