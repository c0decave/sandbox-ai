# nginx 1.28.0 for the showcase presets: a page of its own at / and /app/ passed to the agent's Django at localhost:8000
#
# Build it once: sandbox-ai images build-image web --builtin showcase-web. The FROM below names an exact release
# (nginx 1.28.0, the stable line, released 2025-04-23; its Alpine image); images build-image pulls it once and builds
# it pinned by the digest it got, and records the result by its image ID. Like every image of yours it is marked
# UNCHECKED: sandbox-ai has not reviewed nginx's image.
#
# As a service (--service web:image=web,port=8080,user=101:101) it runs beside the agent in the sandbox's pod: no
# capabilities, a read-only root, user 101 (nginx's own), its network the sandbox's (firewall, connection proxy, VPN).
# So it listens on 8080 (no port below 1024 without a capability), keeps its pid and temporary files in /tmp (the
# tmpfs a read-only root gets) and runs none of the image's entry point scripts (they rewrite /etc/nginx/conf.d).
FROM docker.io/library/nginx:1.28.0-alpine
RUN rm -f /etc/nginx/conf.d/default.conf /docker-entrypoint.d/*.sh
COPY nginx.conf /etc/nginx/nginx.conf
COPY index.html /usr/share/nginx/showcase/index.html
USER 101:101
