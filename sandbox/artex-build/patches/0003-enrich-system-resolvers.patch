@@ -0,0 +1,25 @@
+package enrich
+
+// sandbox-ai's test of its patch: the system's nameservers, never dnsx's public ones.
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestSystemResolvers(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "resolv.conf")
+	text := "# the sandbox's\nnameserver 10.0.2.3\nnameserver ::1\nnameserver not-an-ip\nsearch example\noptions ndots:1\n"
+	if err := os.WriteFile(path, []byte(text), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"udp:10.0.2.3:53", "udp:[::1]:53"}
+	if got := systemResolvers(path); !reflect.DeepEqual(got, want) {
+		t.Fatalf("systemResolvers = %v, want %v", got, want)
+	}
+	if got := systemResolvers(filepath.Join(t.TempDir(), "none")); got != nil {
+		t.Fatalf("no resolv.conf: %v, want none (DNS enrichment off)", got)
+	}
+}
