@@ -0,0 +1,36 @@
+package enrich
+
+// sandbox-ai: asset enrichment asks the system's resolvers, never dnsx's public ones.
+
+import (
+	"bufio"
+	"errors"
+	"net"
+	"os"
+	"strings"
+)
+
+const resolvConf = "/etc/resolv.conf"
+
+var errNoResolvers = errors.New("no nameserver in " + resolvConf)
+
+// systemResolvers: the nameservers of PATH (resolv.conf) as dnsx takes them ("udp:IP:53").
+func systemResolvers(path string) []string {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil
+	}
+	defer f.Close()
+	var found []string
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		if len(fields) < 2 || fields[0] != "nameserver" {
+			continue
+		}
+		if ip := net.ParseIP(fields[1]); ip != nil {
+			found = append(found, "udp:"+net.JoinHostPort(ip.String(), "53"))
+		}
+	}
+	return found
+}
