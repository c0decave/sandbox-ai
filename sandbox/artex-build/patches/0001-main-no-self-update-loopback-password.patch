+package main
+
+// sandbox-ai's test of its patch: both listeners on the loopback only.
+
+import "testing"
+
+func TestLoopbackOnly(t *testing.T) {
+	for _, c := range []struct {
+		value   string
+		emptyOK bool
+		ok      bool
+	}{
+		{"127.0.0.1:8787", false, true}, {"127.0.0.2:1", false, true}, {"localhost:8787", false, true},
+		{"[::1]:8787", false, true}, {":8787", false, false}, {"0.0.0.0:8787", false, false},
+		{"[::]:8787", false, false}, {"10.0.0.5:8787", false, false}, {"example.org:8787", false, false},
+		{"127.0.0.1", false, false}, {"", false, false}, {"", true, true},
+	} {
+		if err := loopbackOnly("-addr", c.value, c.emptyOK); (err == nil) != c.ok {
+			t.Errorf("loopbackOnly(%q, %v) = %v, want ok=%v", c.value, c.emptyOK, err, c.ok)
+		}
+	}
+}
