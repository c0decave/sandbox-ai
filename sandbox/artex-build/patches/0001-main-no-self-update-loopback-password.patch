+// loopbackOnly (sandbox-ai): VALUE of the listen flag NAME is an address on the loopback (127.0.0.0/8, ::1 or
+// localhost) with a port; an empty one only where EMPTY_OK (no recording proxy).
+func loopbackOnly(name, value string, emptyOK bool) error {
+	if value == "" && emptyOK {
+		return nil
+	}
+	host, _, err := net.SplitHostPort(value)
+	if err != nil {
+		return fmt.Errorf("%s %q: %v", name, value, err)
+	}
+	if host == "localhost" {
+		return nil
+	}
+	if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+		return nil
+	}
+	return fmt.Errorf("%s %q: sandbox-ai's build listens on the loopback only (127.0.0.1)", name, value)
 }
 
