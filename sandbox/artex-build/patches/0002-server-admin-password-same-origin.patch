diff --git a/server/sandbox_origin.go b/server/sandbox_origin.go
new file mode 100644
index 0000000..0d7617a
--- /dev/null
+++ b/server/sandbox_origin.go
@@ -0,0 +1,49 @@
+package server
+
+// sandbox-ai: the console and its API answer only requests addressed to the loopback (127.0.0.0/8,
+// ::1 or localhost, any port: the name a DNS-rebinding page would use is refused), and a browser's
+// request from another origin is refused (its Origin header names another scheme, host or port).
+
+import (
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+func sandboxOrigin(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !loopbackHost(r.Host) {
+			http.Error(w, "this console answers only on the loopback (127.0.0.1)", http.StatusForbidden)
+			return
+		}
+		if origin := r.Header.Get("Origin"); origin != "" && !sameOrigin(origin, r.Host) {
+			http.Error(w, "requests from another origin are refused", http.StatusForbidden)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// loopbackHost: HOSTPORT (a request's Host) names the loopback.
+func loopbackHost(hostport string) bool {
+	host := hostport
+	if h, _, err := net.SplitHostPort(hostport); err == nil {
+		host = h
+	}
+	host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+	if strings.EqualFold(host, "localhost") {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
+
+// sameOrigin: ORIGIN (a request's Origin header) is http(s) on exactly the request's HOST.
+func sameOrigin(origin, host string) bool {
+	u, err := url.Parse(origin)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") {
+		return false
+	}
+	return strings.EqualFold(u.Host, host)
+}
diff --git a/server/sandbox_origin_test.go b/server/sandbox_origin_test.go
new file mode 100644
index 0000000..130b6fc
--- /dev/null
+++ b/server/sandbox_origin_test.go
@@ -0,0 +1,121 @@
+package server
+
+// sandbox-ai's tests of its patch: the loopback-only Host, the same-origin check, the token in a URL only for
+// an event stream, and the refused first-caller setup - none of them needs PostgreSQL.
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestLoopbackHost(t *testing.T) {
+	for host, want := range map[string]bool{
+		"127.0.0.1:8787": true, "127.0.0.1": true, "127.9.9.9:80": true, "localhost:8787": true, "LOCALHOST": true,
+		"[::1]:8787": true, "::1": true, "evil.example": false, "evil.example:8787": false, "10.0.0.5:8787": false,
+		"127.0.0.1.nip.io:8787": false, "": false, "[::ffff:10.0.0.5]:80": false,
+	} {
+		if got := loopbackHost(host); got != want {
+			t.Errorf("loopbackHost(%q) = %v, want %v", host, got, want)
+		}
+	}
+}
+
+func TestSameOrigin(t *testing.T) {
+	for _, c := range []struct {
+		origin, host string
+		want         bool
+	}{
+		{"http://127.0.0.1:8787", "127.0.0.1:8787", true},
+		{"https://127.0.0.1:8787", "127.0.0.1:8787", true},
+		{"http://127.0.0.1:8788", "127.0.0.1:8787", false},
+		{"http://evil.example", "127.0.0.1:8787", false},
+		{"null", "127.0.0.1:8787", false},
+		{"file://127.0.0.1:8787", "127.0.0.1:8787", false},
+	} {
+		if got := sameOrigin(c.origin, c.host); got != c.want {
+			t.Errorf("sameOrigin(%q, %q) = %v, want %v", c.origin, c.host, got, c.want)
+		}
+	}
+}
+
+func TestSandboxOriginRefusesOtherHostsAndOrigins(t *testing.T) {
+	handler := sandboxOrigin(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	for _, c := range []struct {
+		host, origin string
+		want         int
+	}{
+		{"127.0.0.1:8787", "", 204},
+		{"127.0.0.1:8787", "http://127.0.0.1:8787", 204},
+		{"localhost:9000", "http://localhost:9000", 204},
+		{"evil.example:8787", "", 403},
+		{"127.0.0.1:8787", "http://evil.example", 403},
+		{"127.0.0.1:8787", "null", 403},
+	} {
+		r := httptest.NewRequest("POST", "/api/tasks", nil)
+		r.Host = c.host
+		if c.origin != "" {
+			r.Header.Set("Origin", c.origin)
+		}
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		if w.Code != c.want {
+			t.Errorf("Host %q Origin %q: status %d, want %d", c.host, c.origin, w.Code, c.want)
+		}
+		if w.Header().Get("Access-Control-Allow-Origin") != "" {
+			t.Errorf("Host %q: an Access-Control-Allow-Origin header", c.host)
+		}
+	}
+}
+
+func TestCorsAddsNoHeader(t *testing.T) {
+	w := httptest.NewRecorder()
+	cors(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})).ServeHTTP(w,
+		httptest.NewRequest("OPTIONS", "/api/tasks", nil))
+	for name := range w.Header() {
+		if strings.HasPrefix(name, "Access-Control-") {
+			t.Errorf("cors sets %s", name)
+		}
+	}
+}
+
+func TestExtractTokenTakesAURLTokenOnlyForAnEventStream(t *testing.T) {
+	plain := httptest.NewRequest("GET", "/api/tasks?token=abc", nil)
+	if got := extractToken(plain); got != "" {
+		t.Errorf("a plain GET's URL token was taken: %q", got)
+	}
+	posted := httptest.NewRequest("POST", "/api/tasks?token=abc", nil)
+	posted.Header.Set("Accept", "text/event-stream")
+	if got := extractToken(posted); got != "" {
+		t.Errorf("a POST's URL token was taken: %q", got)
+	}
+	stream := httptest.NewRequest("GET", "/api/logs/stream?token=abc", nil)
+	stream.Header.Set("Accept", "text/event-stream")
+	if got := extractToken(stream); got != "abc" {
+		t.Errorf("an event stream's URL token: %q, want abc", got)
+	}
+	bearer := httptest.NewRequest("GET", "/api/tasks?token=abc", nil)
+	bearer.Header.Set("Authorization", "Bearer xyz")
+	if got := extractToken(bearer); got != "xyz" {
+		t.Errorf("the bearer token: %q, want xyz", got)
+	}
+}
+
+func TestAuthInitAlwaysRefuses(t *testing.T) {
+	s := &Server{}
+	w := httptest.NewRecorder()
+	s.authInit(w, httptest.NewRequest("POST", "/api/auth/init", strings.NewReader(`{"password":"correct horse battery"}`)))
+	if w.Code != 403 || strings.Contains(w.Body.String(), "token") {
+		t.Fatalf("status=%d body=%s: the first caller must never become the admin", w.Code, w.Body.String())
+	}
+}
+
+func TestSetAdminPasswordNeedsTheStoreAndAValidPassword(t *testing.T) {
+	if err := SetAdminPassword(nil, "long-enough-password"); err == nil {
+		t.Fatal("no store: no error")
+	}
+	if err := SetAdminPassword(&Manager{}, "long-enough-password"); err == nil {
+		t.Fatal("no PostgreSQL: no error")
+	}
+}
