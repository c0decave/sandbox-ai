# Pi (earendil-works/pi, MIT; the pi coding agent) as sandbox-ai's agent pi (sandbox-ai build pi).
# Only the reviewed release (docs/PI_REVIEW.md, sandbox/pi.py): npm's package at the reviewed version and every
# dependency exactly as Containerfile.pi.lock has them, each checked against its sha512 integrity by npm ci; no install
# script runs (--ignore-scripts), nothing is piped into a shell (not Pi's installer either). Pi cannot update itself:
# its install is read-only in the sandbox (a new release is reviewed, then built here).
# uv ships as a static binary in its official image; COPY --from takes only it (MCP servers and kits use uvx).
ARG UV_VERSION=0.13.5
# Floating tag: the current Active LTS line with its newest patch release (Pi needs Node.js 22.19.0 or later). Pin
# with --build-arg NODE_IMAGE=docker.io/library/node:<version>-bookworm-slim.
ARG NODE_IMAGE=docker.io/library/node:lts-bookworm-slim
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${NODE_IMAGE}

# The reviewed release; another one does not match the lock (npm ci refuses it).
ARG PI_VERSION=1.4.0
# fd-find and ripgrep: Pi downloads fd and ripgrep from GitHub when none is installed (its @ completion, grep, find).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash git python3 python3-pip python3-venv firejail nftables ripgrep fd-find util-linux \
    vim netcat-traditional bind9-dnsutils iputils-ping iproute2 traceroute curl wget tmux \
    openssh-client jq openssl \
    && rm -rf /var/lib/apt/lists/*
# GitHub CLI from GitHub's own apt repository (Debian's gh is years behind), the key over HTTPS.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg \
       https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
RUN gh --version
# GUI base (--gui): virtual display, VNC over a Unix socket, fonts and the runtime libraries Playwright's Chromium
# needs (fetched at run time, e.g. `uvx playwright install chromium`).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc x11-utils fonts-liberation fonts-dejavu-core \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcairo-gobject2 libcups2 \
    libdbus-1-3 libdbus-glib-1-2 libdrm2 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcb-shm0 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libxtst6 \
    libegl1 libgl1 libopengl0 libxkbcommon-x11-0 libxcb-cursor0 libxshmfence1 libxkbfile1 libfontconfig1 gdb \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN python3 -m pip --version && uv --version
# Pi exactly as locked (scripts/agent_npm_lock.py pi: every version older than 14 days at the review, each with its
# integrity). Then pi-tui's prebuilt native helpers for other systems and processors go: Node.js on this image never
# loads them.
COPY Containerfile.pi.lock /opt/pi/package-lock.json
RUN printf '{"name":"sandbox-ai-pi","private":true,"dependencies":{"@earendil-works/pi-coding-agent":"%s"}}\n' \
       "${PI_VERSION}" > /opt/pi/package.json \
    && cd /opt/pi && npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && arch=$(node -p 'process.arch') \
    && cd /opt/pi/node_modules/@earendil-works/pi-tui/native \
    && find . -mindepth 1 -maxdepth 1 -type d ! -name linux -exec rm -rf {} + \
    && find linux/prebuilds -mindepth 1 -maxdepth 1 -type d ! -name "linux-${arch}" -exec rm -rf {} + \
    && test "$(node -p 'require("/opt/pi/node_modules/@earendil-works/pi-coding-agent/package.json").version')" = "${PI_VERSION}"
# The image's pi command: Pi's bundle, with sandbox-ai's extension (/etc/pi/sandbox-ai.js, mounted read-only per start
# by the launcher: sandbox/pi.py) whenever it is there - not for Pi's own subcommands (packages, settings, MCP servers,
# credentials), which load no extension of theirs either.
RUN printf '%s\n' '#!/bin/sh' \
       '# sandbox-ai: Pi, with sandbox-ai'"'"'s extension when the launcher mounted it (sandbox/pi.py).' \
       'cli=/opt/pi/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js' \
       'case "${1:-}" in install|remove|uninstall|update|list|config|auth|mcp) exec node "$cli" "$@" ;; esac' \
       'if [ -r /etc/pi/sandbox-ai.js ]; then exec node "$cli" -e /etc/pi/sandbox-ai.js "$@"; fi' \
       'exec node "$cli" "$@"' > /usr/local/bin/pi \
    && chmod 755 /usr/local/bin/pi
# Telemetry is off for every pi (the launcher sets the same, and the network switches, per start).
ENV PI_TELEMETRY=0
# sandbox-ai's telemetry guard (telemetry_guard.py): Pi's bundle (what the pi command runs) imports it first. Whatever
# starts Pi in the sandbox - the launcher, a shell, `node .../cli.js`, another agent - PI_TELEMETRY or PI_OFFLINE
# switched on again, an OpenTelemetry endpoint and the like are refused and the opt-out variables pinned first; the
# launcher mounts its current copy read-only over this one.
COPY telemetry_guard.py /usr/local/lib/sandbox-ai/telemetry_guard.py
RUN python3 -IS /usr/local/lib/sandbox-ai/telemetry_guard.py --install pi
RUN mkdir -p -m 755 /etc/pi \
    && HOME=/tmp/pi-check PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 pi --version && rm -rf /tmp/pi-check
RUN HOME=/tmp/pi-check PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 pi --version \
    && ! HOME=/tmp/pi-check PI_OFFLINE=1 PI_TELEMETRY=1 pi --version 2>/dev/null && rm -rf /tmp/pi-check
ENV HOME=/root
WORKDIR /work
