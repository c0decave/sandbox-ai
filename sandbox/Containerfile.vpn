# The VPN container of sandbox-ai (`sandbox-ai build vpn`): one tunnel in front of a sandbox. WireGuard (the
# kernel's where its module is loaded, else wireguard-go over /dev/net/tun), OpenVPN and Tailscale, nftables for
# the kill switch and python3 for the runtime (sandbox/vpn_runtime.py, mounted read-only at /vpn at every start,
# so a new sandbox-ai version needs no rebuild). No agent and no other tools; Tor is not a VPN and has an image of
# its own (Containerfile.tor, `sandbox-ai build tor`).
ARG DEBIAN_IMAGE=docker.io/library/debian:bookworm-slim
# wireguard-go is built from source (Debian has no package), pinned to a release (override with --build-arg
# WIREGUARD_GO_VERSION=v0.0.YYYYMMDD, or =none to leave it out). It is only the fallback where the host has no
# WireGuard module loaded: when it cannot be built (no network for Go's module proxy; --build-arg GOPROXY=URL
# names another), the image is built without it and says so.
ARG GO_IMAGE=docker.io/library/golang:1.22-bookworm
# Tailscale's own static binaries, from its official image, pinned to a release at least 14 days old (v1.104.2,
# published 2026-10-21; checked 2026-11-10); another with --build-arg TAILSCALE_IMAGE=...:vX.Y.Z.
ARG TAILSCALE_IMAGE=docker.io/tailscale/tailscale:v1.104.2

FROM ${GO_IMAGE} AS wireguard-go
ARG WIREGUARD_GO_VERSION=v0.0.20231211
ARG GOPROXY=https://proxy.golang.org,direct
# /out/status says what became of it; /out/wireguard-go exists only when it was built.
RUN mkdir -p /out \
    && if [ "$WIREGUARD_GO_VERSION" = none ]; then \
         echo "left out (WIREGUARD_GO_VERSION=none)" > /out/status; \
       elif CGO_ENABLED=0 GOBIN=/out timeout 600 go install "golang.zx2c4.com/wireguard@${WIREGUARD_GO_VERSION}"; then \
         mv /out/wireguard /out/wireguard-go && echo "built ${WIREGUARD_GO_VERSION}" > /out/status; \
       else \
         rm -f /out/wireguard; \
         echo "NOT BUILT: go install golang.zx2c4.com/wireguard@${WIREGUARD_GO_VERSION} failed (no network for ${GOPROXY}?)" > /out/status; \
         echo "sandbox-ai build vpn: WARNING: wireguard-go could not be built; the image is built without it." \
              "WireGuard then needs the host's kernel module (sudo modprobe wireguard), or rebuild with network." >&2; \
       fi

FROM ${TAILSCALE_IMAGE} AS tailscale

FROM ${DEBIAN_IMAGE}
# Debian's packages of the base image's release, as the other tools (pin the release with DEBIAN_IMAGE).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates iproute2 nftables wireguard-tools openvpn \
    && rm -rf /var/lib/apt/lists/*
# The status stays in the image: sandbox-ai build vpn reads it back and says it at the end of the build.
COPY --from=wireguard-go /out/ /opt/wireguard-go/
RUN if [ -f /opt/wireguard-go/wireguard-go ]; then \
      install -m 0755 /opt/wireguard-go/wireguard-go /usr/local/bin/wireguard-go && wireguard-go --version; \
    fi \
    && mkdir -p /usr/local/share/sandbox-ai \
    && cp /opt/wireguard-go/status /usr/local/share/sandbox-ai/wireguard-go \
    && echo "wireguard-go: $(cat /usr/local/share/sandbox-ai/wireguard-go)" \
    && rm -rf /opt/wireguard-go
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscaled /usr/local/bin/
# openvpn --version exits non-zero on some releases; the pipe keeps the check to "it runs".
RUN wg --version && (openvpn --version | head -n 1) && tailscale version && nft --version && python3 --version
RUN mkdir -p /vpn /var/lib/tailscale /run/tailscale
LABEL sandbox-ai.role=vpn
ENTRYPOINT ["/usr/bin/python3", "-I", "/vpn/vpn_runtime.py"]
