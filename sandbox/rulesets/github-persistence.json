{
  "version": 1,
  "description": "GitHub API writes that outlive a revoked token: SSH, GPG and deploy keys, webhooks, workflow files, Actions secrets and permissions, collaborators, app installations, branch protection. Each asks with its reason (Knostic, 'Revoking your token won't save you', 2026-06).",
  "http": [
    {"id": "gh-user-keys", "host": "api.github.com", "methods": ["POST", "PUT", "PATCH"],
     "path": ["/user/keys", "/user/keys/**", "/user/gpg_keys", "/user/gpg_keys/**", "/user/ssh_signing_keys",
              "/user/ssh_signing_keys/**"],
     "decision": "ask", "reason": "adds a key to the GitHub account: it keeps working after the token is revoked"},
    {"id": "gh-deploy-keys", "host": "api.github.com", "methods": ["POST", "PUT", "PATCH"],
     "path": ["/repos/*/*/keys", "/repos/*/*/keys/**"],
     "decision": "ask", "reason": "adds a deploy key to a repository: push access that outlives the token"},
    {"id": "gh-webhooks", "host": "api.github.com", "methods": ["POST", "PUT", "PATCH"],
     "path": ["/repos/*/*/hooks", "/repos/*/*/hooks/**", "/orgs/*/hooks", "/orgs/*/hooks/**"],
     "decision": "ask", "reason": "adds or changes a webhook: it sends the repository's events to its URL for good"},
    {"id": "gh-workflow-files", "host": "api.github.com", "methods": ["PUT", "PATCH", "DELETE"],
     "path": ["/repos/*/*/contents/.github/**"],
     "decision": "ask", "reason": "writes a file under .github (a workflow runs with the repository's secrets)"},
    {"id": "gh-actions", "host": "api.github.com", "methods": ["POST", "PUT", "PATCH", "DELETE"],
     "path": ["/repos/*/*/actions/secrets/**", "/repos/*/*/actions/variables/**", "/repos/*/*/actions/permissions/**",
              "/repos/*/*/actions/runners/**", "/repos/*/*/environments/*/secrets/**", "/orgs/*/actions/secrets/**",
              "/orgs/*/actions/runners/**"],
     "decision": "ask", "reason": "changes GitHub Actions secrets, variables, permissions or runners"},
    {"id": "gh-collaborators", "host": "api.github.com", "methods": ["POST", "PUT", "PATCH"],
     "path": ["/repos/*/*/collaborators/*", "/orgs/*/invitations", "/orgs/*/memberships/*",
              "/orgs/*/outside_collaborators/*", "/teams/*/memberships/*", "/orgs/*/teams/*/memberships/*"],
     "decision": "ask", "reason": "gives someone access to a repository or organization"},
    {"id": "gh-installations", "host": "api.github.com", "methods": ["POST", "PUT", "DELETE"],
     "path": ["/user/installations/**", "/orgs/*/installations/**"],
     "decision": "ask", "reason": "adds or removes a GitHub App's access to repositories"},
    {"id": "gh-branch-protection", "host": "api.github.com", "methods": ["PUT", "PATCH", "DELETE"],
     "path": ["/repos/*/*/branches/*/protection", "/repos/*/*/branches/*/protection/**", "/repos/*/*/rulesets/**"],
     "decision": "ask", "reason": "changes a branch's protection or a repository ruleset"}
  ]
}
