# OpenCode 2 (anomalyco/opencode, MIT; npm @opencode/cli) as sandbox-ai's agent opencode2 (sandbox-ai build opencode2),
# beside OpenCode 1 (Containerfile.opencode, npm opencode-ai). Only the reviewed release (docs/OPENCODE2_REVIEW.md,
# sandbox/opencode2.py): the tarball of this machine's platform package from npm's registry, checked against its sha512
# integrity in Containerfile.opencode2.lock before anything of it is unpacked; the one binary it holds is installed
# read-only. Never the @opencode/cli launcher (its install script copies the binary in or runs npm install itself),
# never upstream's curl installer, nothing piped into a shell. OpenCode 2 cannot update itself in the sandbox.
# uv ships as a static binary in its official image; COPY --from takes only it (MCP servers and kits use uvx).
ARG UV_VERSION=0.13.5
# Floating tag: the current Active LTS line with its newest patch release (the agents' common base: Node.js runs MCP
# servers). Pin with --build-arg NODE_IMAGE=docker.io/library/node:<version>-bookworm-slim.
ARG NODE_IMAGE=docker.io/library/node:lts-bookworm-slim
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${NODE_IMAGE}

# The reviewed release; another one has no integrity in the lock (the check below fails).
ARG OPENCODE2_VERSION=2.2.5
# ripgrep: OpenCode 2 downloads it from GitHub when none is installed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash git python3 python3-pip python3-venv firejail nftables ripgrep util-linux \
    vim netcat-traditional bind9-dnsutils iputils-ping iproute2 traceroute curl wget tmux \
    openssh-client jq openssl \
    && rm -rf /var/lib/apt/lists/*
# GitHub CLI from GitHub's own apt repository (Debian's gh is years behind), the key over HTTPS.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg \
       https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
RUN gh --version
# GUI base (--gui): virtual display, VNC over a Unix socket, fonts and the runtime libraries Playwright's Chromium
# needs (fetched at run time, e.g. `uvx playwright install chromium`).
# libxcb-icccm4 and libxcb-keysyms1: Qt's xcb platform (a Qt program with --gui) loads them beside libxcb-cursor0;
# libpulse0: Qt Multimedia loads it (sound itself: the image variant media).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc x11-utils fonts-liberation fonts-dejavu-core \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcairo-gobject2 libcups2 \
    libdbus-1-3 libdbus-glib-1-2 libdrm2 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcb-shm0 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libxtst6 \
    libegl1 libgl1 libopengl0 libxkbcommon-x11-0 libxcb-cursor0 libxshmfence1 libxkbfile1 libfontconfig1 gdb \
    libxcb-icccm4 libxcb-keysyms1 libpulse0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN python3 -m pip --version && uv --version
# OpenCode 2 exactly as locked: the platform package of this machine (on x64 the baseline build when the CPU has no
# AVX2, upstream's own choice), its tarball's sha512 checked against the lock before it is unpacked, its one binary
# installed read-only as opencode, with opencode2 (upstream's second name for it) beside it.
COPY Containerfile.opencode2.lock /opt/opencode2/integrity.lock
RUN arch=$(dpkg --print-architecture) \
    && if [ "$arch" = amd64 ] && ! grep -qw avx2 /proc/cpuinfo; then arch=amd64-baseline; fi \
    && line=$(grep -E "^sha512-[A-Za-z0-9+/=]+  @opencode/cli-linux-[a-z0-9-]+@${OPENCODE2_VERSION}  ${arch}\$" \
              /opt/opencode2/integrity.lock) \
    || { echo "no OpenCode 2 ${OPENCODE2_VERSION} for ${arch} in the lock" >&2; exit 1; } \
    && integrity=${line%%  *} && spec=$(echo "$line" | awk '{print $2}') && package=${spec%@*} \
    && mkdir -p /tmp/opencode2-dl && cd /tmp/opencode2-dl \
    && curl -fsSL --proto '=https' --tlsv1.2 -o package.tgz \
       "https://registry.npmjs.org/${package}/-/${package#@opencode/}-${OPENCODE2_VERSION}.tgz" \
    && test "sha512-$(openssl dgst -sha512 -binary package.tgz | base64 -w0)" = "$integrity" \
    && tar -xzf package.tgz package/bin/opencode \
    && install -m 0755 package/bin/opencode /usr/local/bin/opencode \
    && ln -s opencode /usr/local/bin/opencode2 \
    && cd / && rm -rf /tmp/opencode2-dl \
    && test "$(HOME=/tmp/opencode2-check /usr/local/bin/opencode2 --version)" = "opencode v${OPENCODE2_VERSION}" \
    && rm -rf /tmp/opencode2-check
# Telemetry is off for every opencode2 (the launcher sets the same, and the update and catalog switches, per start).
ENV DO_NOT_TRACK=1 BUN_ENABLE_CRASH_REPORTING=0 OTEL_SDK_DISABLED=true
# sandbox-ai's telemetry guard (telemetry_guard.py): `opencode2` and `opencode` (the same binary) are shims that check,
# then become OpenCode 2 (its binary moves to /usr/local/lib/sandbox-ai/real). Whatever starts it in the sandbox - the
# launcher, a shell, another agent - an OpenTelemetry endpoint, Bun's crash reports or another system configuration
# (OPENCODE_TEST_MANAGED_CONFIG_DIR) is refused and the opt-out variables are pinned first; the launcher mounts its
# current copy read-only over this one.
COPY telemetry_guard.py /usr/local/lib/sandbox-ai/telemetry_guard.py
RUN python3 -IS /usr/local/lib/sandbox-ai/telemetry_guard.py --install opencode2
RUN HOME=/tmp/opencode2-check opencode2 --version && HOME=/tmp/opencode2-check opencode --version \
    && ! HOME=/tmp/opencode2-check OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:9 opencode2 --version 2>/dev/null \
    && rm -rf /tmp/opencode2-check
ENV HOME=/root
WORKDIR /work
