# Letta Code (letta-ai/letta-code, Apache-2.0) as sandbox-ai's agent letta (sandbox-ai build letta).
# Only the reviewed release (docs/LETTA_REVIEW.md, sandbox/letta.py): npm's package at the reviewed version and every
# dependency exactly as Containerfile.letta.lock has them (the package's own npm-shrinkwrap.json pins), each checked
# against its sha512 integrity by npm ci; no install script runs (--ignore-scripts: not Letta Code's, not Scarf's
# install analytics, not the downloads of ripgrep's), nothing is piped into a shell. Letta Code cannot update itself:
# its install is read-only in the sandbox (a new release is reviewed, then built here).
# uv ships as a static binary in its official image; COPY --from takes only it (MCP servers and kits use uvx).
ARG UV_VERSION=0.13.5
# Floating tag: the current Active LTS line with its newest patch release (Letta Code needs Node.js 22.23.4, 24.22.1
# or 26.12.1 and later of each line). Pin with --build-arg NODE_IMAGE=docker.io/library/node:<version>-bookworm-slim.
ARG NODE_IMAGE=docker.io/library/node:lts-bookworm-slim
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${NODE_IMAGE}

# The reviewed release; another one does not match the lock (npm ci refuses it).
ARG LETTA_VERSION=0.34.36
# fd-find and ripgrep: Letta Code downloads fd and ripgrep from GitHub when none is installed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash git python3 python3-pip python3-venv firejail nftables ripgrep fd-find util-linux \
    vim netcat-traditional bind9-dnsutils iputils-ping iproute2 traceroute curl wget tmux \
    openssh-client jq openssl \
    && rm -rf /var/lib/apt/lists/*
# GitHub CLI from GitHub's own apt repository (Debian's gh is years behind), the key over HTTPS.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg \
       https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
RUN gh --version
# GUI base (--gui): virtual display, VNC over a Unix socket, fonts and the runtime libraries Playwright's Chromium
# needs (fetched at run time, e.g. `uvx playwright install chromium`).
# libxcb-icccm4 and libxcb-keysyms1: Qt's xcb platform (a Qt program with --gui) loads them beside libxcb-cursor0;
# libpulse0: Qt Multimedia loads it (sound itself: the image variant media).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc x11-utils fonts-liberation fonts-dejavu-core \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcairo-gobject2 libcups2 \
    libdbus-1-3 libdbus-glib-1-2 libdrm2 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcb-shm0 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libxtst6 \
    libegl1 libgl1 libopengl0 libxkbcommon-x11-0 libxcb-cursor0 libxshmfence1 libxkbfile1 libfontconfig1 gdb \
    libxcb-icccm4 libxcb-keysyms1 libpulse0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN python3 -m pip --version && uv --version
# Letta Code exactly as locked (scripts/agent_npm_lock.py letta: every version older than 14 days at the review, each
# with its integrity). Then the packages of other systems and processors (sharp's, ripgrep's and Cursor's prebuilt
# binaries for darwin, win32, musl and the like) and the Electron-only sharp go: Node.js on this image never loads
# them (about 960 MB to 400 MB).
COPY Containerfile.letta.lock /opt/letta/package-lock.json
RUN printf '{"name":"sandbox-ai-letta","private":true,"dependencies":{"@letta-ai/letta-code":"%s"}}\n' \
       "${LETTA_VERSION}" > /opt/letta/package.json \
    && cd /opt/letta && npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && arch=$(node -p 'process.arch') \
    && cd /opt/letta/node_modules/@letta-ai/letta-code/node_modules \
    && rm -rf @janhapke \
    && find @img @cursor @vscode -mindepth 1 -maxdepth 1 -type d \
         \( -name 'sharp-*' -o -name 'sdk-*' -o -name 'ripgrep-*' \) ! -name "*-linux-${arch}" -exec rm -rf {} + \
    && test "$(node -p 'require("/opt/letta/node_modules/@letta-ai/letta-code/package.json").version')" = "${LETTA_VERSION}" \
    && ln -s /opt/letta/node_modules/@letta-ai/letta-code/letta.js /usr/local/bin/letta
# Its start script and what it lays in are mounted here by the launcher (read-only, sandbox/letta.py); telemetry is
# off for every letta (the launcher sets the same, and the update check's switch, per start).
ENV LETTA_CODE_TELEM=0 DO_NOT_TRACK=1 SCARF_ANALYTICS=false
# sandbox-ai's telemetry guard (telemetry_guard.py): Letta Code's entry file (letta.js) imports it first. Whatever
# starts it in the sandbox - the launcher, a shell, another agent - LETTA_CODE_TELEM or Scarf's analytics switched on,
# an OpenTelemetry endpoint and the like are refused and the opt-out variables pinned first; the launcher mounts its
# current copy read-only over this one.
COPY telemetry_guard.py /usr/local/lib/sandbox-ai/telemetry_guard.py
RUN python3 -IS /usr/local/lib/sandbox-ai/telemetry_guard.py --install letta
# --version checks for updates too unless told not to.
RUN mkdir -p -m 755 /etc/letta \
    && HOME=/tmp/letta-check DISABLE_AUTOUPDATER=1 letta --version && rm -rf /tmp/letta-check
RUN HOME=/tmp/letta-check DISABLE_AUTOUPDATER=1 letta --version \
    && ! HOME=/tmp/letta-check DISABLE_AUTOUPDATER=1 LETTA_CODE_TELEM=1 letta --version 2>/dev/null \
    && rm -rf /tmp/letta-check
ENV HOME=/root
WORKDIR /work
